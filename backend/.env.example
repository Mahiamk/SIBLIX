# --- Database ------------------------------------------------------------
# Local dev default (no Docker needed): sqlite:///./storage/app.db
# docker-compose: postgresql+psycopg2://sdoc:sdoc@postgres:5432/sdoc
DATABASE_URL=postgresql+psycopg2://sdoc:sdoc@postgres:5432/sdoc

# --- Authentication --------------------------------------------------------
# Accounts live in the `users` table; everyone must register via
# POST /auth/register. There are no built-in credentials.
# AUTH_SECRET signs session tokens — set a unique value per deployment.
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL=43200
# Set to 1 to bypass auth entirely while testing the API with curl/Postman.
DISABLE_AUTH=0

# --- AI layer --------------------------------------------------------------
# Optional. The deterministic rules/NLP layer decides the vast majority of
# traffic; a model is only consulted when the rules find nothing to go on.
# Providers are tried in order: OpenAI first, then Gemini. Leave both unset
# to run the pipeline fully offline and deterministically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback provider used when OpenAI is unavailable (no credits, bad key).
# Use a "-latest" alias: pinned versions 404 once Google retires them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Guard rails for the fallback path:
#   LLM_TIMEOUT      seconds per request (no SDK retries)
#   LLM_MAX_FAILURES consecutive failures before a provider self-disables
#   LLM_MAX_CALLS    per-process call budget; 0 disables the cap. A real
#                    mailbox is mostly non-shipping mail, so without a cap a
#                    large sync would spend minutes confirming that.
LLM_TIMEOUT=20
LLM_MAX_FAILURES=3
LLM_MAX_CALLS=50

# --- Evaluation integration -------------------------------------------------
# Base URL of the organizers' scoring server (the sdoc-hackathon-docker
# package). Not part of this docker-compose — that's the organizers' service.
EVAL_SERVER_URL=http://eval-server:8000

# --- Storage ---------------------------------------------------------------
STORAGE_ROOT=/app/storage
